# Claude writes the travel advice and place suggestions. Without a key the app uses its climate rules.
ANTHROPIC_API_KEY=
SKYCAST_MODEL=claude-opus-5-5

# LangSmith tracing: every graph run, Open-Meteo call and Claude call shows up as a trace.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skycast
